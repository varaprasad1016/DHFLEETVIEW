target
nbactions.xml
.classpath
.project
.settings
.idea
*.iml
.DS_Store
.checkstyle
.gradle
out
# build (allow traccar-web/build for deployment)
build/
!traccar-web/build/
!traccar-web/build/**
.vscode
bin

# DH FleetView local/excluded
local-data/
release/
traccar-client/
environment/dhfleetview.keystore
environment/key.properties

# Apple signing and App Store Connect credentials
appconnect.txt
*.p8
*.p12
*.mobileprovision

# DH FleetView runtime/local
logs/
data/
web.backup-*/


# ffmpeg binary (145MB) - fetched on deploy via tools/setup-ffmpeg.ps1
tools/ffmpeg.exe

# jar backups from deploy cycles
tracker-server.jar.backup-*
# Graphify AST cache - rebuilt by "graphify update .", not source
graphify-out/cache/

# Live server settings. This checkout has the running tacho server deployed at
# its root, so a .env with the real SMTP password, DH FleetView API token,
# DVR SMS key and JWT secret sits here. It must never be committed.
.env
.env.*
!.env.example

# Things that live beside the source but are not the source.
# The embedded Postgres, its logs and the pairing PIN.
.runtime/
# The virtual environment.
.venv/
# A third-party binary: installed, not built here.
tools/tachograph-go/
# Tachograph downloads are operator data, never source.
*.ddd
