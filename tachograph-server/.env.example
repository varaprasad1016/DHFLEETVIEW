# --- Listener ports ---
TACHOSYNC_PORT=29000
GPRS_PORT=21756
TBA_WS_PORT=8765
API_PORT=8000

# --- Infrastructure ---
DATABASE_URL=postgresql+asyncpg://tacho:tacho@postgres:5432/tacho
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tacho-files
MINIO_SECURE=false

# --- Compliance windows (days, EU 561/2006) ---
DRIVER_INTERVAL_DAYS=28
VEHICLE_INTERVAL_DAYS=90
DRIVER_WARNING_DAYS=25
VEHICLE_WARNING_DAYS=85

# --- Driver-card parser -----------------------------------------------------
# Optional MIT tachograph-go CLI. If blank, use tachograph on PATH.
TACHO_PARSER_ENABLED=true
TACHO_PARSER_BINARY=
TACHO_PARSER_TIMEOUT=30
TACHO_PARSER_AUTHENTICATE=false
TACHO_PARSER_FALLBACK=false

# --- Account tenancy --------------------------------------------------------
# Uploads are assigned automatically to this account's customer company.
# Leave blank only when the database contains exactly one active company.
TACHO_ACCOUNT_COMPANY_ID=

# --- Security ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=720

# --- TLS (optional) ---
TLS_ENABLED=false
TLS_CERT_PATH=
TLS_KEY_PATH=

# --- Monthly licence (phone-approved killswitch) ---
LICENSE_ENFORCE=true
LICENSE_SERVER_ID=dhfleetview-tacho
# Set a fresh one-time PIN for the initial phone pairing, then blank it.
LICENSE_PAIRING_PIN=
LICENSE_APPROVAL_WINDOW_SECONDS=900
LICENSE_RENEW_DAY=15
